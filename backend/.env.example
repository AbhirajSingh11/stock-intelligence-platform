# Optional comma-separated frontend origins allowed to call FastAPI.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Async SQLAlchemy URL for the persisted watchlist, transactions, and manual marks.
# The default below is used when this variable is absent.
DATABASE_URL=sqlite+aiosqlite:///./data/stock-intelligence.db

# Required for SEC routes. Replace the placeholder with a monitored contact.
SEC_USER_AGENT=Stock Intelligence Platform contact@example.com

# Optional SEC client settings. Defaults remain below the SEC's 10 requests/sec limit.
SEC_RATE_LIMIT_PER_SECOND=5
SEC_CONNECT_TIMEOUT_SECONDS=5
SEC_READ_TIMEOUT_SECONDS=15
SEC_TICKER_CACHE_TTL_SECONDS=86400
SEC_SUBMISSIONS_CACHE_TTL_SECONDS=900
SEC_COMPANY_FACTS_CACHE_TTL_SECONDS=900
